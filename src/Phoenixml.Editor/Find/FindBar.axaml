<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phoenixml.Editor.Find.FindBar">
    <Border Background="#1E1E1E"
            BorderBrush="#4A4A4F"
            BorderThickness="0,0,0,1"
            Padding="6,4">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox Name="QueryBox" Width="240" Watermark="Find"
                     VerticalAlignment="Center" />
            <ToggleButton Name="MatchCaseToggle" Content="Aa" Width="28"
                          Height="28" VerticalAlignment="Center"
                          ToolTip.Tip="Match case" />
            <TextBlock Name="CounterText" VerticalAlignment="Center"
                       Foreground="#9D9D9D"
                       MinWidth="80" />
            <Button Name="PrevButton" Content="↑" Width="28" Height="28"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Previous (Shift+Enter)" />
            <Button Name="NextButton" Content="↓" Width="28" Height="28"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Next (Enter)" />
            <Button Name="CloseButton" Content="✕" Width="28" Height="28"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Close (Esc)" />
        </StackPanel>
    </Border>
</UserControl>
