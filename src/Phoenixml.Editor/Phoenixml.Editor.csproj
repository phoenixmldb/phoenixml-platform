<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Phoenixml.Editor</RootNamespace>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon></ApplicationIcon>
    <Description>Phoenixml.Editor — XML/XSD authoring app. v0.1 minimum-viable runnable.</Description>
    <!-- CA1515: Avalonia requires App to be public (XAML loader resolves it by name at runtime).
         NU1903: Tmds.DBus.Protocol 0.20.0 high-severity advisory — transitive via Avalonia.Desktop
         on Linux. Not shipped; suppress rather than pin a patched transitive.
         CA2007: library-code advice that's wrong for UI apps. Awaits in commands MUST resume
         on the captured Avalonia UI SynchronizationContext so continuations can mutate the
         view tree. Following CA2007 here is what caused the first run's "Call from invalid
         thread" crash — the suppression is deliberate. -->
    <!-- CA1001/CA2000: EditorMainWindow owns EditorValidationService (IDisposable) but both
         live for the application lifetime — disposal on process exit is correct behaviour
         for a desktop app. Making App or EditorMainWindow implement IDisposable cascades
         through Avalonia's sealed type hierarchy without benefit. -->
    <NoWarn>$(NoWarn);CA1515;NU1903;CA2007;CA1001;CA2000;CA1054;CA1056;CA1819;CA1308</NoWarn>
    <NuGetAuditSuppress>https://github.com/advisories/GHSA-xrw6-gwf8-vvr9</NuGetAuditSuppress>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Phoenixml.Platform/Phoenixml.Platform.csproj" />
    <ProjectReference Include="../Phoenixml.Platform.Editor.Xml/Phoenixml.Platform.Editor.Xml.csproj" />
    <ProjectReference Include="../Phoenixml.Platform.Editor.Text/Phoenixml.Platform.Editor.Text.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Views/SyntaxHighlighting/XQuery.xshd" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Phoenixml.Editor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Plan 27 #8: auto-publish LSP servers into $(OutputPath)tools/ before each build.
    Skipped when the sibling phoenixmldb-xquery / phoenixmldb-xslt repos aren't checked
    out, or when the published binary already exists (incremental builds stay fast).
    ContinueOnError keeps the editor build green even if the LSP publish fails.
  -->
  <Target Name="PublishLspServers" BeforeTargets="Build">
    <PropertyGroup>
      <_LspToolsDir>$(OutputPath)tools</_LspToolsDir>
      <_XQueryLspSrc>$(MSBuildThisFileDirectory)../../../phoenixmldb/phoenixmldb-xquery/src/PhoenixmlDb.XQuery.LanguageServer</_XQueryLspSrc>
      <_XsltLspSrc>$(MSBuildThisFileDirectory)../../../phoenixmldb/phoenixmldb-xslt/src/PhoenixmlDb.Xslt.LanguageServer</_XsltLspSrc>
    </PropertyGroup>
    <Exec
      Condition="Exists('$(_XQueryLspSrc)') And !Exists('$(_LspToolsDir)/phoenixmldb-xquery-lsp')"
      Command="dotnet publish &quot;$(_XQueryLspSrc)&quot; -c Release -o &quot;$(_LspToolsDir)&quot;"
      ContinueOnError="true" />
    <Exec
      Condition="Exists('$(_XsltLspSrc)') And !Exists('$(_LspToolsDir)/phoenixmldb-xslt-lsp')"
      Command="dotnet publish &quot;$(_XsltLspSrc)&quot; -c Release -o &quot;$(_LspToolsDir)&quot;"
      ContinueOnError="true" />
  </Target>
</Project>
