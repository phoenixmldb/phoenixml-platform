<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Phoenixml.Platform</RootNamespace>
    <Description>Foundation library for the Phoenixml family of XML-aware tools — document model, undo/redo, editor primitives, account/license/update plumbing, theming, shell, hosting.</Description>
    <PackageTags>xml;phoenixml;editor;document-model;undo;avalonia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Phoenixml.Platform.Tests" />
    <InternalsVisibleTo Include="Phoenixml.Platform.ArchTests" />
  </ItemGroup>
</Project>
