<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Phoenixml.Platform.Shell"
        x:Class="Phoenixml.Platform.Shell.MainWindow"
        Title="Phoenixml"
        Width="1200" Height="800"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="BorderOnly"
        Background="{DynamicResource Phoenixml.Color.Surface.Base}">
    <Grid RowDefinitions="32,*,Auto">
        <!-- Custom title bar -->
        <Border Grid.Row="0" Name="TitleBar"
                Background="{DynamicResource Phoenixml.Color.Surface.Raised}"
                PointerPressed="TitleBar_PointerPressed">
            <DockPanel>
                <StackPanel Name="WindowsButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="—" Click="Minimize_Click" Width="46" Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource Phoenixml.Color.Content.Primary}"
                            BorderThickness="0" />
                    <Button Content="▢" Click="Maximize_Click" Width="46" Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource Phoenixml.Color.Content.Primary}"
                            BorderThickness="0" />
                    <Button Content="✕" Click="Close_Click" Width="46" Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource Phoenixml.Color.Content.Primary}"
                            BorderThickness="0" />
                </StackPanel>
                <TextBlock Name="TitleLabel" Text="Phoenixml" VerticalAlignment="Center"
                           Margin="12,0"
                           Foreground="{DynamicResource Phoenixml.Color.Content.Primary}" />
            </DockPanel>
        </Border>

        <!-- Content slot — apps inject their content here -->
        <ContentPresenter Grid.Row="1" Name="ContentSlot" />

        <!-- Status bar -->
        <shell:StatusBar Grid.Row="2" Name="StatusBarControl" />
    </Grid>
</Window>
