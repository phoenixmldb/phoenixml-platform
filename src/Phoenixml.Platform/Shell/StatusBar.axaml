<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phoenixml.Platform.Shell.StatusBar">
    <Border Background="#007ACC" Height="28">
        <ItemsControl Name="SegmentsHost" Margin="0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,1,0" BorderBrush="#005FA0" Padding="8,0">
                        <TextBlock Text="{Binding}" Foreground="White" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
